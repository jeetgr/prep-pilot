# ─── Database (Neon) ──────────────────────────────────────────
# Direct (non-pooled) connection, used by Prisma Migrate only
# Neon dashboard → Connect → turn "Connection pooling" off
DIRECT_URL=

# Pooled connection, used by the app at runtime
# Neon dashboard → Connect → turn "Connection pooling" on (host contains "-pooler")
DATABASE_URL=

# ─── Auth (Better Auth) ───────────────────────────────────────
# Public URL of the app, e.g. http://localhost:3000 in dev
BETTER_AUTH_URL=

# Secret used to sign sessions and tokens (32+ chars)
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────
# API key from resend.com → API Keys (starts with "re_")
RESEND_API_KEY=

# Sender shown in emails. Without a verified domain, use the Resend test sender:
# PrepPilot <onboarding@resend.dev>
EMAIL_FROM=

# ─── Tooling ──────────────────────────────────────────────────
# Set to "true" to skip env validation (Docker builds, CI lint jobs)
SKIP_ENV_VALIDATION=

# ─── OAuth (Google) ───────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
