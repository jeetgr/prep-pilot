# Neon non-pooled connection string: postgresql://user:pass@host/db?sslmode=require
DIRECT_URL=

# Neon pooled connection string: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# When true it will skip the env validation. Which can be used in env like CI or Docker build
SKIP_ENV_VALIDATION=

# Base URL of your app
BETTER_AUTH_URL=

# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
